# Copy to .env and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------
DATABASE_URL=postgresql://mailagent:mailagent@localhost:5432/mailagent
# From Google AI Studio (aistudio.google.com), looks like AIzaSy...
# This is NOT a GCP service-account JSON and NOT the OAuth client secret below.
GEMINI_API_KEY=AIzaSy...

# --- Core -------------------------------------------------------------------
APP_ENV=dev

# Master kill switch for external writes. Keep true until M06.
DRY_RUN=true

# IANA zone. Used to ground relative dates ("next Tuesday") and to render
# approval cards in the zone you actually think in. Not an offset.
USER_TIMEZONE=Asia/Karachi
# Your own address. Stripped from extracted attendee lists.
OWNER_EMAIL=you@example.com
# Other addresses that reach you, as a JSON list (M15 measurement). An alias
# missing here makes the loose-ends count undercount.
OWNER_ALIASES=[]
# Senders the M15 measurement ignores, as a JSON list: your own test mail.
MEASURE_EXCLUDE_SENDERS=[]

# --- Models (M03) -----------------------------------------------------------
# Check what your key can reach: .\tasks.ps1 models
EXTRACTION_MODEL=gemini-2.5-pro
CLASSIFY_MODEL=gemini-2.5-flash

# --- Vercel AI Gateway (optional) -------------------------------------------
# Only for triaging on TypeSafe's Jev evaluation model instead of Gemini:
#   CLASSIFY_MODEL=typesafe-ai/jev
# Jev answers "should this create a calendar event?" as a probability and is
# billed on input only. It has not been scored against the golden set yet, so
# compare, on the same settings, before switching:
#   .\tasks.ps1 eval --extractor gemini
#   .\tasks.ps1 eval --extractor jev
# Email text then goes to TypeSafe AI through Vercel, and the gateway lists no
# zero-data-retention option for this model. Create a key in the Vercel
# dashboard under AI Gateway > API Keys.
AI_GATEWAY_API_KEY=

# --- Retrieval (M10) --------------------------------------------------------
# Changing either of these invalidates the whole corpus: vectors from different
# models, or of different widths, cannot be compared. A change means re-running
# ingestion over everything before search works again.
EMBEDDING_MODEL=gemini-embedding-001
# Must match the width of chunks.embedding. Ingestion refuses to start if not.
EMBEDDING_DIMENSIONS=1536

# vector or hybrid. Defaults to vector because that is what M12 measured:
# fusion never surfaced a relevant message vector search had missed, and cost
# 7 points of hit@5. See results/retrieval-comparison.md.
RETRIEVAL_MODE=vector

# --- Google (M01) -----------------------------------------------------------
GOOGLE_CLIENT_SECRETS_PATH=./secrets/client_secret.json
GOOGLE_TOKEN_PATH=./secrets/token.enc
# Optional second token (M15). If Google rejects the primary, polling carries
# on with this one. Mint it like the primary:
#   .\tasks.ps1 reauth --minted-under production
# (with GOOGLE_TOKEN_PATH pointed at this file for that one run).
GOOGLE_TOKEN_STANDBY_PATH=
# Dedicated throwaway calendar. Nothing touches your primary calendar until M06.
TEST_CALENDAR_ID=
# Fernet key encrypting the OAuth token at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Telegram (M06) ---------------------------------------------------------
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Any random string. Telegram echoes it in the X-Telegram-Bot-Api-Secret-Token
# header; without it the webhook URL is the only thing between the internet and
# a bot that writes to your calendar. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# JSON list. Empty means nobody can talk to the bot -- the safe default, since
# this bot reads your mailbox. Find your ID with:
#   .\tasks.ps1 telegram --whoami
# The first entry also receives unsolicited proposals.
ALLOWED_CHAT_IDS=[]
# Externally reachable base URL, for registering the webhook (M07 deploy).
# Leave blank locally and use `.\tasks.ps1 telegram --poll` instead.
PUBLIC_URL=

# --- Web channel (M16) --------------------------------------------------------
# The bearer secret the web app's server sends to /api/*. The same value goes
# in the web app's environment (dashboard/.env.example). Blank means the API
# answers 503 and /health shows only its public fields. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEB_API_SECRET=
# Signs web pushes. Generate the pair with `.\tasks.ps1 vapid`: the private
# half goes here (a Fly secret in production) and nowhere else; the public
# half goes to the web app as NEXT_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PRIVATE_KEY=
# The web app's bare https origin, such as https://mailagent.vercel.app: no
# path, no port. Web push sends it to Apple and Google as the VAPID subject,
# in place of your email. Push is off until this and VAPID_PRIVATE_KEY are set.
WEB_APP_URL=
# The iPhone sign-in fallback: /api/pairing/* answer 404 until this is true.
# Turn it on only if Google sign-in fails inside the installed iPhone app, and
# set the web app's PAIRING_ENABLED=true to match.
PAIRING_ENABLED=false

# --- Deployment (M07) --------------------------------------------------------
# Start the in-process poller. Off locally so `serve` and tests do not quietly
# begin processing real mail; on in the deployed environment.
RUN_SCHEDULER=false
POLL_INTERVAL_MINUTES=10
POLL_BATCH_SIZE=10

# Apply migrations at boot. Fine on one instance, a race on two.
MIGRATE_ON_BOOT=false

# Deploy only. The OAuth client secret and encrypted tokens are files, but a
# container gets environment variables -- and none may be baked into the
# image. Base64 them up and the app writes them to disk at startup:
#   GOOGLE_CLIENT_SECRETS_B64=$(base64 -w0 secrets/client_secret.json)
#   GOOGLE_TOKEN_B64=$(base64 -w0 secrets/token-prod.enc)
#   GOOGLE_TOKEN_STANDBY_B64=$(base64 -w0 secrets/token-standby-prod.enc)
# FERNET_KEY must be the key that encrypted those tokens: a production-only
# key, never the one in this file. See docs/DEPLOY.md.

# --- Integration tests --------------------------------------------------------
# Not here: put TEST_DATABASE_URL in .env.test (gitignored) and run
#   uv run --env-file .env.test pytest -m integration
# Use a direct connection string. Transaction-mode poolers (Supabase :6543,
# Neon "-pooler" hosts) are refused.
