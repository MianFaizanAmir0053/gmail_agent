# Same database the agent writes traces to. In production this is the
# read-only `web_reader` role over Supabase's session pooler (M16), with no
# `sslmode` in it: every connection off this machine is encrypted by the app.
DATABASE_URL=postgresql://mailagent:mailagent@localhost:5432/mailagent

# Supabase's CA certificate, pasted whole (docs/DEPLOY.md §9.3). With it, the
# app checks the server's certificate; without it, the connection is still
# encrypted but not checked. Not needed for a database on this machine.
DATABASE_CA_CERT=

# Owner-only Google sign-in (Auth.js v5). The OAuth client belongs to its own
# Google Cloud project, published "In production", with only the
# `openid email profile` scopes. Its redirect URI is
#   <app URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Signs the session cookie. Rotating it signs out every device, which is how a
# lost device is revoked. Generate one:
#   npx auth secret      (or: openssl rand -base64 33)
AUTH_SECRET=

# The only address admitted, and only once Google has verified it. Blank
# admits nobody.
OWNER_EMAIL=

# The Fly API, the web app's only write path. Server-side only: the browser
# never sees either value, and never calls Fly. WEB_API_SECRET must match Fly's.
FLY_API_URL=https://mailagent.fly.dev
WEB_API_SECRET=

# The owner's zone: set it to the same zone as the agent's USER_TIMEZONE.
# Every time on the timeline is shown in it. A missing or unknown value falls
# back to UTC, and the timeline names the zone it uses.
OWNER_TIMEZONE=Asia/Karachi

# Web push: the public half of the pair `.\tasks.ps1 vapid` prints. The
# private half stays on Fly. Next builds this value into the page, so redeploy
# after setting or changing it. Blank means notifications cannot be turned on.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Where the agent writes eval results, relative to the dashboard directory.
EVAL_RESULTS_DIR=../results
