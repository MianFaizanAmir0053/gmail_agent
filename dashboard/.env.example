# Same database the agent writes traces to.
DATABASE_URL=postgresql://mailagent:mailagent@localhost:5432/mailagent

# Single shared token. This is a one-person internal tool: a full user system
# would cost days and teach nothing the rest of the project does not already
# demonstrate. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
DASHBOARD_TOKEN=change-me

# Where the agent writes eval results, relative to the dashboard directory.
EVAL_RESULTS_DIR=../results
